{
  "name": "@moonshot/marketing",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "postbuild": "node scripts/write-runtime-config.mjs",
    "preview": "node scripts/write-runtime-config.mjs && vite preview",
    "start": "node scripts/write-runtime-config.mjs && vite preview --host 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src"
  },
  "dependencies": {
    "@moonshot/domain": "workspace:*",
    "@moonshot/types": "workspace:*",
    "@moonshot/web-runtime": "workspace:*",
    "framer-motion": "^12.43.0",
    "heic2any": "^0.0.4",
    "pdfjs-dist": "^6.4.299",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "typescript": "^5.9.3",
    "vite": "^8.2.0"
  }
}

# Marketing site env — safe to commit (never put secrets here)

# Deep-linked admin URLs on the Start Free / Sign In buttons.
VITE_ADMIN_SIGNUP_URL=http://localhost:5174/signup
VITE_ADMIN_LOGIN_URL=http://localhost:5174/login

# Moonshot API base URL (no trailing slash). The menu-engineering tool POSTs
# multipart uploads to {VITE_API_BASE_URL}/api/v1/menu-engineering/extract.
# Dev default:  http://localhost:3000
# Production:   https://moonshotapi-production.up.railway.app
VITE_API_BASE_URL=http://localhost:3000

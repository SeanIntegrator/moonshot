{
  "name": "@moonshot/admin",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "postbuild": "node scripts/write-runtime-config.mjs",
    "preview": "node scripts/write-runtime-config.mjs && vite preview",
    "start": "node scripts/write-runtime-config.mjs && vite preview --host 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vitest run"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@moonshot/domain": "workspace:*",
    "@moonshot/types": "workspace:*",
    "@moonshot/web-runtime": "workspace:*",
    "@mui/icons-material": "^9.2.0",
    "@mui/material": "^9.2.0",
    "@phosphor-icons/react": "^2.1.10",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^6.30.4",
    "socket.io-client": "^4.8.3"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "typescript": "^5.9.3",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  }
}

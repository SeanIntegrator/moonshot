PORT=3000
# Must include a username before @ (Railway/Neon URLs already do). A bare host or empty user causes:
#   PostgreSQL error 28000 — "no PostgreSQL user name specified in startup packet"
DATABASE_URL=postgres://user:pass@localhost:5432/moonshot
JWT_SECRET=change-me-in-production
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
# Comma-separated emails allowed to POST/PATCH/DELETE menu items (Phase 1)
MENU_ADMIN_EMAILS=owner@example.com
# Bootstrap pre-seeded café admin (`pnpm bootstrap:admin-user`). Invite flow replaces this later.
# On a new DB, run `pnpm migrate` (same DATABASE_URL) first so `admin_users` exists.
# ADMIN_BOOTSTRAP_CAFE_SLUG=clay-and-bean
# ADMIN_BOOTSTRAP_EMAIL=owner@example.com
# ADMIN_BOOTSTRAP_PASSWORD=change-me-8-chars-min
# Production (NODE_ENV=production): comma-separated full browser origins (scheme + host).
# Local dev: leave empty for permissive localhost / Vite defaults.
# Railway example — include EVERY live public origin (Railway may expose hyphenated
# and non-hyphenated aliases for the same service; a near-miss is denied):
# CORS_ORIGINS=https://moonshotorder-ahead-production.up.railway.app,https://moonshot-kds-production.up.railway.app,https://moonshot-admin-production.up.railway.app,https://moonshotkds-production.up.railway.app,https://moonshotadmin-production.up.railway.app,https://moonshotmarketing-production.up.railway.app
# Working API host is moonshotapi-production (no hyphen). moonshot-api-production is a broken duplicate.
CORS_ORIGINS=

# Stripe Connect + Checkout (API only — never commit live keys)
# STRIPE_API_KEY=rk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# API callbacks for Stripe Account Links (browser GET; café id in signed `state` query param)
# STRIPE_CONNECT_RETURN_URL=https://your-api-origin/api/v1/admin/payments/stripe/return
# STRIPE_CONNECT_REFRESH_URL=https://your-api-origin/api/v1/admin/payments/stripe/refresh
# Admin SPA to open after return (or rely on CORS_ORIGINS containing an `admin` host)
# STRIPE_CONNECT_ADMIN_REDIRECT_URL=https://your-admin-origin
# Order-ahead Stripe return URLs (API only — one base URL for all cafés; slug is appended per checkout)
# ORDER_AHEAD_BASE_URL=http://localhost:5176
# Production example: ORDER_AHEAD_BASE_URL=https://moonshot-order-ahead-production.up.railway.app
# Local webhooks (optional — checkout return recovery confirms paid orders without this):
#   stripe listen --forward-to localhost:3000/api/v1/webhooks/stripe
# Legacy (single static URL for all cafés — avoid for multi-tenant slug routing):
# ORDER_AHEAD_SUCCESS_URL=https://your-order-ahead-origin/bobo/checkout/restore?checkout_session_id={CHECKOUT_SESSION_ID}
# ORDER_AHEAD_CANCEL_URL=https://your-order-ahead-origin/bobo/checkout

# Square OAuth + Catalog import (see docs/square-oauth.md)
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# POS_TOKEN_ENCRYPTION_KEY=
# SQUARE_APPLICATION_ID=
# SQUARE_APPLICATION_SECRET=
# SQUARE_ENVIRONMENT=sandbox
# SQUARE_OAUTH_REDIRECT_URL=http://localhost:3000/api/v1/admin/connect/square/return
# SQUARE_CONNECT_ADMIN_REDIRECT_URL=http://localhost:5174/onboarding/import-pos
# Cron (Railway): POST /api/v1/internal/pos/refresh-tokens every 6–12h with this secret
# CRON_SECRET=
# Daily safety-net: POST /api/v1/internal/pos/sync-catalogs (same CRON_SECRET)
# App-level Square webhooks (see docs/square-oauth.md)
# SQUARE_WEBHOOK_SIGNATURE_KEY=
# Must match the Dashboard notification URL exactly (used in HMAC):
# SQUARE_WEBHOOK_NOTIFICATION_URL=http://localhost:3000/api/v1/webhooks/square
# Production: https://moonshotapi-production.up.railway.app/api/v1/webhooks/square
# Subscribe to order.* and catalog.version.updated on the same app-level webhook.

# Menu item thumbnails (Railway Object Storage — private bucket; browsers use the API media proxy)
# Map Railway's default AWS_* bucket credentials to MENU_IMAGE_* on the API service.
# Railway `${{bucket.VAR}}` references only interpolate on Railway — copy resolved
# values into this local .env (never commit secrets).
# MENU_IMAGE_BUCKET=moonshot-menu-images
# MENU_IMAGE_ENDPOINT=https://storage.railway.app
# MENU_IMAGE_REGION=auto
# MENU_IMAGE_ACCESS_KEY_ID=
# MENU_IMAGE_SECRET_ACCESS_KEY=
# Local (shared prod DB/bucket): MENU_IMAGE_PUBLIC_BASE_URL=https://your-api-host/api/v1/media
# Local-only DB: MENU_IMAGE_PUBLIC_BASE_URL=http://localhost:3000/api/v1/media
# Prod:  MENU_IMAGE_PUBLIC_BASE_URL=https://your-api-host/api/v1/media

{
  "name": "@moonshot/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "build": "tsc",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vitest run",
    "migrate": "node --env-file-if-exists=.env ./node_modules/node-pg-migrate/bin/node-pg-migrate.js up -m migrations",
    "migrate:down": "node --env-file-if-exists=.env ./node_modules/node-pg-migrate/bin/node-pg-migrate.js down -m migrations",
    "bootstrap:kds-user": "tsx --env-file-if-exists=.env scripts/bootstrap-kds-user.ts",
    "bootstrap:admin-user": "tsx --env-file-if-exists=.env scripts/bootstrap-admin-user.ts",
    "replay:order-loyalty": "tsx --env-file-if-exists=.env scripts/replay-order-loyalty.ts",
    "sync:menu-template-images": "tsx --env-file-if-exists=.env scripts/sync-menu-template-images.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1102.0",
    "@moonshot/domain": "workspace:*",
    "@moonshot/types": "workspace:*",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "file-type": "^22.0.1",
    "google-auth-library": "^10.9.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.2.0",
    "node-pg-migrate": "^8.0.4",
    "pg": "^8.22.0",
    "sharp": "^0.35.3",
    "socket.io": "^4.8.3",
    "square": "^45.0.1",
    "stripe": "^22.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^1.4.13",
    "@types/node": "^22.20.1",
    "@types/pg": "^8.20.4",
    "@types/supertest": "^6.0.3",
    "socket.io-client": "^4.8.3",
    "supertest": "^7.2.2",
    "tsx": "^4.23.5",
    "typescript": "^5.9.3",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  }
}

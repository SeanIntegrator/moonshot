{
  "name": "@moonshot/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "build": "tsc",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "migrate": "node --env-file-if-exists=.env ./node_modules/node-pg-migrate/bin/node-pg-migrate.js up -m migrations",
    "migrate:down": "node --env-file-if-exists=.env ./node_modules/node-pg-migrate/bin/node-pg-migrate.js down -m migrations",
    "bootstrap:kds-user": "tsx --env-file-if-exists=.env scripts/bootstrap-kds-user.ts",
    "bootstrap:admin-user": "tsx --env-file-if-exists=.env scripts/bootstrap-admin-user.ts",
    "replay:order-loyalty": "tsx --env-file-if-exists=.env scripts/replay-order-loyalty.ts",
    "sync:menu-template-images": "tsx --env-file-if-exists=.env scripts/sync-menu-template-images.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1076.0",
    "@moonshot/types": "workspace:*",
    "cors": "^2.8.6",
    "express": "^5.1.0",
    "file-type": "^22.0.1",
    "google-auth-library": "^10.6.2",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.2.0",
    "node-pg-migrate": "^8.0.4",
    "pg": "^8.20.0",
    "sharp": "^0.35.2",
    "socket.io": "^4.8.3",
    "square": "^45.0.0",
    "stripe": "^17.7.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.13.0",
    "@types/pg": "^8.20.0",
    "@types/supertest": "^6.0.2",
    "socket.io-client": "^4.8.3",
    "supertest": "^7.0.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.3",
    "vitest": "^3.0.9"
  }
}

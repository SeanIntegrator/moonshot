{
  "name": "@moonshot/web-runtime",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/realtime/react.d.ts",
      "import": "./dist/realtime/react.js"
    },
    "./write-runtime-config": "./scripts/write-runtime-config.mjs"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "dependencies": {
    "@moonshot/domain": "workspace:*",
    "@moonshot/types": "workspace:*",
    "socket.io-client": "^4.8.3"
  },
  "peerDependencies": {
    "react": "^19.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "@types/react": "^19.2.18",
    "react": "^19.2.8",
    "socket.io": "^4.8.3",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  }
}
